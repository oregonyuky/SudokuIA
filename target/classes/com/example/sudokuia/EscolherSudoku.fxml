                        <font>
                            <Font size="21" />
                        </font>
                    </Label>


                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label text="①">
                            <font>
                                <Font size="30" />
                            </font>
                        </Label>

                        <Label prefWidth="310" text="Cada linha deve conter os números de 1 a 9 sem repetição." wrapText="true" />

                    </HBox>


                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label text="②">
                            <font>
                                <Font size="30" />
                            </font>
                        </Label>

                        <Label prefWidth="310" text="Cada coluna deve conter os números de 1 a 9 sem repetição." wrapText="true" />

                    </HBox>


                    <HBox alignment="CENTER_LEFT" spacing="15">

                        <Label text="③">
                            <font>
                                <Font size="30" />
                            </font>
                        </Label>

                        <Label prefWidth="310" text="Cada bloco 3x3 deve conter os números de 1 a 9 sem repetição." wrapText="true" />

