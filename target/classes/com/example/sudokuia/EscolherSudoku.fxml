                    <Label text="Informações do Sudoku">
                        <font>
                            <Font size="22" />
                        </font>
                    </Label>

                    <GridPane hgap="30" vgap="14">

                        <Label text="Nome:" />

                        <Label fx:id="lblNome" text="Fácil" GridPane.columnIndex="1" />

                        <Label text="Dificuldade:" GridPane.rowIndex="1" />

                        <Label fx:id="lblDificuldade" text="Fácil" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Células preenchidas:" GridPane.rowIndex="2" />

                        <Label fx:id="lblPreenchidas" text="30 / 81" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <columnConstraints>
