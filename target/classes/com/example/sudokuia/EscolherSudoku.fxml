    <!-- ===================================================== -->
    <!-- RODAPÉ -->
    <!-- ===================================================== -->

    <bottom>

        <VBox>

            <Separator />

            <HBox alignment="CENTER_LEFT" spacing="15">

                <padding>
                    <Insets bottom="15" left="25" right="25" top="15" />
                </padding>

                <Button onAction="#sair" prefHeight="45" prefWidth="120" text="↪  Sair" />

                <Region HBox.hgrow="ALWAYS" />

                <Button disable="true" prefHeight="45" prefWidth="130" text="‹  Voltar" />

                <Button fx:id="btnProximo" onAction="#proximo" prefHeight="45" prefWidth="140" text="Próximo  ›" />

            </HBox>

        </VBox>

    </bottom>

</BorderPane>
